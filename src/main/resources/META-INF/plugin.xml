<idea-plugin>
    <id>com.github.pablolec.play1toolkit</id>
    <name>Play v1 Toolkit</name>
    <vendor url="https://github.com/PabloLec">PabloLec</vendor>

    <description><![CDATA[
        <p>Modern IntelliJ IDEA support for legacy Play Framework 1.x applications.</p>
        <br/>
        <p>Features:</p>
        <ul>
            <li>Automatic Play 1 project detection</li>
            <li>Play Framework library attachment (resolves <code>import play.mvc.*</code>)</li>
            <li>Source root configuration (<code>app/</code>, <code>test/</code>, <code>conf/</code>)</li>
            <li>Play 1 run and debug configuration</li>
            <li>conf/routes syntax highlighting and navigation</li>
            <li>Diagnostic report and repair action</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <resource-bundle>messages.Play1ToolkitBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Settings -->
        <applicationService serviceImplementation="com.github.pablolec.play1toolkit.config.Play1Settings"/>

        <applicationConfigurable
                parentId="tools"
                id="play1toolkit.settings"
                displayName="Play v1 Toolkit"
                instance="com.github.pablolec.play1toolkit.config.Play1SettingsConfigurable"/>

        <!-- Project Services -->
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.services.Play1ProjectService"/>
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.project.Play1LibWatcher"/>

        <!-- Startup Activity -->
        <postStartupActivity implementation="com.github.pablolec.play1toolkit.Play1StartupActivity"/>

        <!-- Run Configuration -->
        <configurationType implementation="com.github.pablolec.play1toolkit.run.Play1RunConfigurationType"/>

        <!-- Notification Group -->
        <notificationGroup id="Play v1 Toolkit"
                           displayType="BALLOON"
                           key="notification.group"/>

        <!-- Routes Custom Language -->
        <fileType name="Routes"
                  language="Routes"
                  implementationClass="com.github.pablolec.play1toolkit.routes.RoutesFileType"
                  fileNames="routes"/>

        <lang.syntaxHighlighterFactory language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.RoutesSyntaxHighlighterFactory"/>

        <lang.parserDefinition language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.RoutesParserDefinition"/>

        <lang.findUsagesProvider language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.RoutesFindUsagesProvider"/>

        <completion.contributor language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.RoutesCompletionContributor"
                order="first"/>

        <psi.referenceContributor language="Routes"
                implementation="com.github.pablolec.play1toolkit.routes.RoutesReferenceContributor"/>

        <annotator language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.RoutesAnnotator"/>

        <!-- Tool Window -->
        <toolWindow id="Play v1 Toolkit"
                    anchor="right"
                    secondary="true"
                    factoryClass="com.github.pablolec.play1toolkit.toolwindow.Play1ToolWindowFactory"
                    icon="AllIcons.Actions.Run_anything"/>

        <!-- render() → view navigation -->
        <gotoDeclarationHandler
                implementation="com.github.pablolec.play1toolkit.render.Play1RenderViewGotoHandler"/>

        <!-- conf/routes → Java controller/action navigation -->
        <gotoDeclarationHandler
                implementation="com.github.pablolec.play1toolkit.routes.RoutesGotoDeclarationHandler"/>

        <!-- Java controller/action → conf/routes navigation -->
        <gotoDeclarationHandler
                implementation="com.github.pablolec.play1toolkit.lineMarker.JavaToRoutesGotoDeclarationHandler"/>

        <!-- Gutter icons: controller ↔ routes -->
        <codeInsight.lineMarkerProvider language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.lineMarker.Play1ControllerLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.lineMarker.Play1RoutesLineMarkerProvider"/>

        <!-- Java usage search integration for code vision / find usages -->
        <referencesSearch implementation="com.github.pablolec.play1toolkit.routes.RoutesClassReferencesSearcher"/>
        <methodReferencesSearch implementation="com.github.pablolec.play1toolkit.routes.RoutesMethodReferencesSearcher"/>

        <!-- Suppresses "unused" warning on public static Controller actions routed in conf/routes -->
        <implicitUsageProvider implementation="com.github.pablolec.play1toolkit.lineMarker.Play1ControllerImplicitUsageProvider"/>

        <!-- Inspections -->
        <localInspection language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.inspection.Play1MissingViewInspection"
                displayName="Missing Play 1 view for render() call"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WARNING"/>
    </extensions>

    <actions>
        <group id="Play1ToolkitMenu" text="Play v1 Toolkit" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

        <action id="Play1Toolkit.RepairProjectSetup"
                class="com.github.pablolec.play1toolkit.actions.RepairProjectSetupAction"
                text="Repair Project Setup"
                description="Attach Play 1 libraries, configure source roots, and create run configuration">
            <add-to-group group-id="Play1ToolkitMenu" anchor="first"/>
        </action>

        <action id="Play1Toolkit.SyncDependencies"
                class="com.github.pablolec.play1toolkit.actions.Play1SyncDepsAction"
                text="Sync Dependencies"
                description="Run play deps to download and attach project dependencies">
            <add-to-group group-id="Play1ToolkitMenu" anchor="after" relative-to-action="Play1Toolkit.RepairProjectSetup"/>
        </action>
    </actions>
</idea-plugin>
