<idea-plugin url="https://github.com/PabloLec/play1-intellij-plugin">
    <id>com.github.pablolec.play1toolkit</id>
    <name>Play v1 Toolkit</name>
    <vendor url="https://github.com/PabloLec">PabloLec</vendor>

    <description><![CDATA[
        <p>Modern IntelliJ IDEA support for legacy Play Framework 1.x applications.</p>
        <p>Play v1 Toolkit helps IntelliJ understand the parts of a Play 1 application that usually degrade into plain text and broken navigation.</p>
        <ul>
            <li>Automatic Play 1 project detection and repair</li>
            <li>Framework and project library attachment</li>
            <li>Play 1 run, debug, and CLI integration</li>
            <li>Deep support for <code>conf/routes</code>, <code>application.conf</code>, and <code>messages*</code></li>
            <li>Navigation, completion, and inspections for templates, reverse routes, assets, and render() calls</li>
            <li>Static analysis for JPA models, jobs, cached fragments, and action response types</li>
            <li>Dedicated tool window with status, routes, templates, models, jobs, cache, and diagnostics views</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <p>See the GitHub release for details.</p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <resource-bundle>messages.Play1ToolkitBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <iconMapper mappingFile="PlayPluginIconMappings.json"/>

        <!-- Settings -->
        <applicationService serviceImplementation="com.github.pablolec.play1toolkit.config.Play1Settings"/>

        <applicationConfigurable
                parentId="tools"
                id="play1toolkit.settings"
                displayName="Play v1 Toolkit"
                instance="com.github.pablolec.play1toolkit.config.Play1SettingsConfigurable"/>

        <!-- Project Services -->
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.services.Play1ProjectService"/>
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.project.Play1LibWatcher"/>
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.response.PlayActionResponseService"/>
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.templates.service.PlayTemplateService"/>
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.templates.service.PlayTemplateVariableResolver"/>

        <!-- Startup Activity -->
        <postStartupActivity implementation="com.github.pablolec.play1toolkit.Play1StartupActivity"/>

        <!-- Run Configuration -->
        <configurationType implementation="com.github.pablolec.play1toolkit.run.Play1RunConfigurationType"/>

        <!-- Notification Group -->
        <notificationGroup id="Play v1 Toolkit"
                           displayType="BALLOON"
                           key="notification.group"/>

        <!-- Routes Custom Language -->
        <fileType name="Routes"
                  language="Routes"
                  implementationClass="com.github.pablolec.play1toolkit.routes.RoutesFileType"
                  fileNames="routes"/>

        <lang.syntaxHighlighterFactory language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.RoutesSyntaxHighlighterFactory"/>

        <lang.parserDefinition language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.RoutesParserDefinition"/>

        <lang.findUsagesProvider language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.RoutesFindUsagesProvider"/>

        <completion.contributor language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.RoutesCompletionContributor"
                order="first"/>

        <psi.referenceContributor language="Routes"
                implementation="com.github.pablolec.play1toolkit.routes.RoutesReferenceContributor"/>

        <annotator language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.RoutesAnnotator"/>

        <codeInsight.inlayProvider language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.routes.Play1RoutesResponseInlayHintsProvider"
                settingsKeyId="play-v1.route.responses"
                enabledByDefault="true"/>

        <!-- Tool Window -->
        <toolWindow id="Play v1 Toolkit"
                    anchor="right"
                    secondary="true"
                    factoryClass="com.github.pablolec.play1toolkit.toolwindow.Play1ToolWindowFactory"
                    icon="/icons/playToolWindow.svg"/>

        <!-- render() → view navigation -->
        <gotoDeclarationHandler
                implementation="com.github.pablolec.play1toolkit.render.Play1RenderViewGotoHandler"/>
        <gotoDeclarationHandler
                implementation="com.github.pablolec.play1toolkit.templates.goto.PlayTemplateGotoDeclarationHandler"/>

        <!-- conf/routes → Java controller/action navigation -->
        <gotoDeclarationHandler
                implementation="com.github.pablolec.play1toolkit.routes.RoutesGotoDeclarationHandler"/>

        <!-- Java controller/action → conf/routes navigation -->
        <gotoDeclarationHandler
                implementation="com.github.pablolec.play1toolkit.lineMarker.JavaToRoutesGotoDeclarationHandler"/>

        <!-- Gutter icons: controller ↔ routes -->
        <codeInsight.lineMarkerProvider language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.lineMarker.Play1ControllerLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.lineMarker.Play1ActionResponseLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="Routes"
                implementationClass="com.github.pablolec.play1toolkit.lineMarker.Play1RoutesLineMarkerProvider"/>

        <!-- Java usage search integration for code vision / find usages -->
        <referencesSearch implementation="com.github.pablolec.play1toolkit.routes.RoutesClassReferencesSearcher"/>
        <methodReferencesSearch implementation="com.github.pablolec.play1toolkit.routes.RoutesMethodReferencesSearcher"/>

        <!-- Suppresses "unused" warning on public static Controller actions routed in conf/routes -->
        <implicitUsageProvider implementation="com.github.pablolec.play1toolkit.lineMarker.Play1ControllerImplicitUsageProvider"/>

        <!-- Inspections -->
        <localInspection language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.inspection.Play1MissingViewInspection"
                displayName="Missing Play 1 view for render() or renderTemplate() call"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WARNING"/>

        <!-- Play templates and custom tags -->
        <psi.referenceContributor language="HTML"
                implementation="com.github.pablolec.play1toolkit.templates.references.PlayTemplateHtmlReferenceContributor"/>
        <psi.referenceContributor language="XML"
                implementation="com.github.pablolec.play1toolkit.templates.references.PlayTemplateHtmlReferenceContributor"/>
        <psi.referenceContributor language="JAVA"
                implementation="com.github.pablolec.play1toolkit.templates.references.PlayTemplateJavaReferenceContributor"/>

        <completion.contributor language="HTML"
                implementationClass="com.github.pablolec.play1toolkit.templates.completion.PlayTemplateCompletionContributor"
                order="last"/>
        <completion.contributor language="XML"
                implementationClass="com.github.pablolec.play1toolkit.templates.completion.PlayTemplateCompletionContributor"
                order="last"/>
        <annotator language="HTML"
                implementationClass="com.github.pablolec.play1toolkit.templates.PlayTemplateReferenceAnnotator"/>
        <annotator language="XML"
                implementationClass="com.github.pablolec.play1toolkit.templates.PlayTemplateReferenceAnnotator"/>
        <completion.contributor language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.templates.completion.PlayTemplateJavaCompletionContributor"
                order="last"/>

        <platform.backend.documentation.targetProvider
                implementation="com.github.pablolec.play1toolkit.templates.documentation.PlayTemplateDocumentationTargetProvider"/>

        <codeInsight.lineMarkerProvider language="HTML"
                implementationClass="com.github.pablolec.play1toolkit.templates.lineMarker.PlayTemplateLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="XML"
                implementationClass="com.github.pablolec.play1toolkit.templates.lineMarker.PlayTemplateLineMarkerProvider"/>

        <referencesSearch implementation="com.github.pablolec.play1toolkit.templates.references.PlayTemplateFileUsageSearcher"/>
        <referencesSearch implementation="com.github.pablolec.play1toolkit.templates.references.PlayTemplateRouteClassReferencesSearcher"/>
        <referencesSearch implementation="com.github.pablolec.play1toolkit.templates.references.PlayTemplateRouteActionUsageSearcher"/>
        <methodReferencesSearch implementation="com.github.pablolec.play1toolkit.templates.references.PlayTemplateRouteMethodReferencesSearcher"/>

        <localInspection
                implementationClass="com.github.pablolec.play1toolkit.templates.inspection.PlayTemplateMissingPathInspection"
                displayName="Missing Play 1 template file"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WARNING"/>
        <localInspection
                implementationClass="com.github.pablolec.play1toolkit.templates.inspection.PlayTemplateUnknownTagInspection"
                displayName="Unknown Play 1 template tag"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <localInspection
                implementationClass="com.github.pablolec.play1toolkit.templates.inspection.PlayTemplateUnknownRouteInspection"
                displayName="Unknown Play v1 reverse route"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <localInspection
                implementationClass="com.github.pablolec.play1toolkit.templates.inspection.PlayTemplateMissingAssetInspection"
                displayName="Missing Play v1 static asset"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WARNING"/>
        <localInspection
                implementationClass="com.github.pablolec.play1toolkit.templates.inspection.PlayTemplateUnknownVariableInspection"
                displayName="Unknown Play v1 template variable"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <localInspection
                implementationClass="com.github.pablolec.play1toolkit.templates.inspection.PlayTemplateTagBalanceInspection"
                displayName="Unbalanced Play v1 template tag"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <localInspection
                implementationClass="com.github.pablolec.play1toolkit.templates.inspection.PlayTemplateActionNotRoutedInspection"
                displayName="Play v1 action not declared in conf/routes"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <localInspection
                implementationClass="com.github.pablolec.play1toolkit.templates.inspection.PlayTemplateRouteArgCountInspection"
                displayName="Suspicious Play v1 reverse route argument count"
                groupName="Play v1 Toolkit"
                enabledByDefault="false"
                level="INFORMATION"/>

        <!-- PlayConfig Custom Language -->
        <fileType name="PlayConfig"
                  language="PlayConfig"
                  implementationClass="com.github.pablolec.play1toolkit.playconfig.lang.PlayConfigFileType"
                  fileNames="application.conf"/>

        <lang.syntaxHighlighterFactory language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.lang.PlayConfigSyntaxHighlighterFactory"/>

        <lang.parserDefinition language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.lang.PlayConfigParserDefinition"/>

        <lang.findUsagesProvider language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.references.PlayConfigFindUsagesProvider"/>

        <!-- PlayConfig Services -->
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.playconfig.service.PlayConfigService"/>
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.playconfig.settings.PlayConfigProjectSettings"/>

        <!-- PlayConfig Settings -->
        <projectConfigurable
                parentId="play1toolkit.settings"
                id="play1toolkit.config.intelligence"
                displayName="Configuration Intelligence"
                instance="com.github.pablolec.play1toolkit.playconfig.settings.PlayConfigConfigurable"/>

        <!-- PlayConfig References (Java → conf) -->
        <psi.referenceContributor language="JAVA"
                implementation="com.github.pablolec.play1toolkit.playconfig.references.PlayConfigJavaReferenceContributor"/>

        <!-- PlayConfig Find Usages (conf → Java) -->
        <referencesSearch implementation="com.github.pablolec.play1toolkit.playconfig.references.PlayConfigJavaUsageSearcher"/>

        <!-- PlayConfig Rename -->
        <renamePsiElementProcessor
                implementation="com.github.pablolec.play1toolkit.playconfig.references.PlayConfigRenameProcessor"/>

        <!-- PlayConfig Completion -->
        <completion.contributor language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.completion.PlayConfigJavaCompletionContributor"
                order="last"/>
        <completion.contributor language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.completion.PlayConfigConfCompletionContributor"/>

        <!-- PlayConfig Inlay Hints -->
        <codeInsight.inlayProvider language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.hints.PlayConfigJavaInlayHintsProvider"
                settingsKeyId="play-v1.config.java-values"
                enabledByDefault="true"/>
        <codeInsight.inlayProvider language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.hints.PlayConfigConfInlayHintsProvider"
                settingsKeyId="play-v1.config.conf-markers"
                enabledByDefault="true"/>

        <!-- PlayConfig Documentation -->
        <platform.backend.documentation.targetProvider
                implementation="com.github.pablolec.play1toolkit.playconfig.documentation.PlayConfigDocumentationTargetProvider"/>

        <!-- PlayConfig Line Markers -->
        <codeInsight.lineMarkerProvider language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.lineMarker.PlayConfigLineMarkerProvider"/>

        <!-- PlayConfig Inspections -->
        <localInspection language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.inspections.UnresolvedPlayConfigKeyInspection"
                displayName="Unresolved Play configuration key"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <localInspection language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.inspections.UnusedPlayConfigKeyInspection"
                displayName="Unused Play configuration key"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="INFORMATION"/>
        <localInspection language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.inspections.DuplicatePlayConfigKeyInspection"
                displayName="Duplicate Play configuration key"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WARNING"/>
        <localInspection language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.inspections.ProfileOverrideWithoutDefaultInspection"
                displayName="Profile override without default value"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="INFORMATION"/>
        <localInspection language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.inspections.UnresolvedEnvironmentVariableInspection"
                displayName="Unresolved environment variable"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <localInspection language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.inspections.SuspiciousProfilePrefixInspection"
                displayName="Suspicious profile prefix"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <localInspection language="PlayConfig"
                implementationClass="com.github.pablolec.play1toolkit.playconfig.inspections.UnknownPlayFrameworkKeyInspection"
                displayName="Unknown Play framework key"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>

        <!-- PlayMessages Custom Language -->
        <fileType name="PlayMessages"
                  language="PlayMessages"
                  implementationClass="com.github.pablolec.play1toolkit.playmessages.lang.PlayMessagesFileType"
                  fileNames="messages"
                  patterns="messages.*"/>

        <fileTypeDetector implementationClass="com.github.pablolec.play1toolkit.playmessages.lang.PlayMessagesFileTypeDetector"/>

        <lang.syntaxHighlighterFactory language="PlayMessages"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.lang.PlayMessagesSyntaxHighlighterFactory"/>

        <lang.parserDefinition language="PlayMessages"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.lang.PlayMessagesParserDefinition"/>

        <lang.findUsagesProvider language="PlayMessages"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.references.PlayMessagesFindUsagesProvider"/>

        <!-- PlayMessages Service -->
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.playmessages.service.PlayMessagesService"/>

        <!-- PlayMessages References: Java → messages -->
        <psi.referenceContributor language="JAVA"
                implementation="com.github.pablolec.play1toolkit.playmessages.references.PlayMessagesJavaReferenceContributor"/>

        <!-- PlayMessages References: HTML → messages -->
        <psi.referenceContributor language="HTML"
                implementation="com.github.pablolec.play1toolkit.playmessages.references.PlayMessagesHtmlReferenceContributor"/>

        <!-- PlayMessages Find Usages: messages → Java -->
        <referencesSearch implementation="com.github.pablolec.play1toolkit.playmessages.references.PlayMessagesJavaUsageSearcher"/>

        <!-- PlayMessages Find Usages: messages → HTML -->
        <referencesSearch implementation="com.github.pablolec.play1toolkit.playmessages.references.PlayMessagesHtmlUsageSearcher"/>

        <!-- PlayMessages HTML navigation: Ctrl+Click &{'key'} → messages declaration -->
        <gotoDeclarationHandler
                implementation="com.github.pablolec.play1toolkit.playmessages.references.PlayMessagesHtmlGotoDeclarationHandler"/>

        <!-- PlayMessages Rename -->
        <renamePsiElementProcessor
                implementation="com.github.pablolec.play1toolkit.playmessages.references.PlayMessagesRenameProcessor"/>

        <!-- PlayMessages Completion -->
        <completion.contributor language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.completion.PlayMessagesJavaCompletionContributor"
                order="last"/>
        <completion.contributor language="HTML"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.completion.PlayMessagesHtmlCompletionContributor"
                order="last"/>

        <!-- PlayMessages Inlay Hints -->
        <codeInsight.inlayProvider language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.hints.PlayMessagesJavaInlayHintsProvider"
                settingsKeyId="play-v1.messages.java-values"
                enabledByDefault="true"/>
        <codeInsight.inlayProvider language="HTML"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.hints.PlayMessagesHtmlInlayHintsProvider"
                settingsKeyId="play-v1.messages.html-values"
                enabledByDefault="true"/>

        <!-- PlayMessages Documentation -->
        <platform.backend.documentation.targetProvider
                implementation="com.github.pablolec.play1toolkit.playmessages.documentation.PlayMessagesDocumentationTargetProvider"/>

        <!-- PlayMessages Line Markers -->
        <codeInsight.lineMarkerProvider language="PlayMessages"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.lineMarker.PlayMessagesLineMarkerProvider"/>

        <!-- PlayMessages Inspections -->
        <localInspection language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.inspections.UnknownPlayMessageKeyJavaInspection"
                displayName="Unknown Play message key"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <localInspection language="HTML"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.inspections.UnknownPlayMessageKeyHtmlInspection"
                displayName="Unknown Play message key (template)"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <localInspection language="PlayMessages"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.inspections.DuplicatePlayMessageKeyInspection"
                displayName="Duplicate Play message key"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WARNING"/>
        <localInspection language="PlayMessages"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.inspections.MissingLocaleTranslationInspection"
                displayName="Missing locale translation"
                groupName="Play v1 Toolkit"
                enabledByDefault="false"
                level="INFORMATION"/>
        <localInspection language="JAVA"
                implementationClass="com.github.pablolec.play1toolkit.playmessages.inspections.PlaceholderCountMismatchInspection"
                displayName="Placeholder count mismatch in Messages.get()"
                groupName="Play v1 Toolkit"
                enabledByDefault="true"
                level="WEAK WARNING"/>
        <!-- Play JPA Models -->
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.playjpa.service.PlayJpaModelService"/>
        <codeInsight.lineMarkerProvider language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.lineMarker.PlayJpaModelLineMarkerProvider"/>
        <platform.backend.documentation.targetProvider
            implementationClass="com.github.pablolec.play1toolkit.playjpa.documentation.PlayJpaDocumentationTargetProvider"
            order="first"/>
        <codeInsight.inlayProvider language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.hints.PlayJpaFinderInlayHintsProvider"
            settingsKeyId="play-jpa.finder.hints"
            enabledByDefault="false"/>
        <psi.referenceContributor language="JAVA"
            implementation="com.github.pablolec.play1toolkit.playjpa.references.PlayJpaFinderReferenceContributor"/>
        <completion.contributor language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.completion.PlayJpaFinderCompletionContributor"
            order="last"/>
        <localInspection language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.inspection.PlayJpaModelWithoutEntityInspection"
            displayName="Play JPA model without @Entity"
            groupName="Play v1 Toolkit"
            shortName="PlayJpaModelWithoutEntity"
            enabledByDefault="true"
            level="WEAK WARNING"/>
        <localInspection language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.inspection.PlayJpaEntityNotExtendingModelInspection"
            displayName="Play @Entity not extending Model"
            groupName="Play v1 Toolkit"
            shortName="PlayJpaEntityNotExtendingModel"
            enabledByDefault="true"
            level="INFORMATION"/>
        <localInspection language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.inspection.PlayJpaUnknownFinderFieldInspection"
            displayName="Unknown field in Play JPA finder"
            groupName="Play v1 Toolkit"
            shortName="PlayJpaUnknownFinderField"
            enabledByDefault="true"
            level="WEAK WARNING"/>
        <localInspection language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.inspection.PlayJpaFinderParamCountInspection"
            displayName="Play JPA finder parameter count mismatch"
            groupName="Play v1 Toolkit"
            shortName="PlayJpaFinderParamCount"
            enabledByDefault="false"
            level="WEAK WARNING"/>
        <psi.referenceContributor language="YAML"
            implementation="com.github.pablolec.play1toolkit.playjpa.references.PlayYamlReferenceContributor"/>
        <completion.contributor language="YAML"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.completion.PlayYamlModelCompletionContributor"
            order="last"/>
        <completion.contributor language="YAML"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.completion.PlayYamlFieldCompletionContributor"
            order="last"/>
        <completion.contributor language="YAML"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.completion.PlayYamlRelationTargetCompletionContributor"
            order="last"/>
        <localInspection language="YAML"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.inspection.PlayYamlUnknownModelInspection"
            displayName="Unknown model in Play fixture"
            groupName="Play v1 Toolkit"
            shortName="PlayYamlUnknownModel"
            enabledByDefault="true"
            level="WEAK WARNING"/>
        <localInspection language="YAML"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.inspection.PlayYamlUnknownFieldInspection"
            displayName="Unknown field in Play fixture"
            groupName="Play v1 Toolkit"
            shortName="PlayYamlUnknownField"
            enabledByDefault="true"
            level="WEAK WARNING"/>
        <localInspection language="YAML"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.inspection.PlayYamlUnknownRelationTargetInspection"
            displayName="Unknown fixture alias in Play fixture relation"
            groupName="Play v1 Toolkit"
            shortName="PlayYamlUnknownRelationTarget"
            enabledByDefault="true"
            level="WEAK WARNING"/>
        <localInspection language="YAML"
            implementationClass="com.github.pablolec.play1toolkit.playjpa.inspection.PlayYamlDuplicateAliasInspection"
            displayName="Duplicate fixture alias in Play fixture"
            groupName="Play v1 Toolkit"
            shortName="PlayYamlDuplicateAlias"
            enabledByDefault="true"
            level="WARNING"/>
        <referencesSearch implementation="com.github.pablolec.play1toolkit.playjpa.references.PlayJpaModelUsageSearcher"/>
        <referencesSearch implementation="com.github.pablolec.play1toolkit.playjpa.references.PlayJpaFieldUsageSearcher"/>
        <renamePsiElementProcessor implementation="com.github.pablolec.play1toolkit.playjpa.references.PlayJpaRenameProcessor"/>
        <renamePsiElementProcessor implementation="com.github.pablolec.play1toolkit.playjpa.references.PlayJpaFieldRenameProcessor"/>
        <renamePsiElementProcessor implementation="com.github.pablolec.play1toolkit.playjpa.references.PlayYamlFixtureAliasRenameProcessor"/>

        <!-- Play Jobs support -->
        <projectService serviceImplementation="com.github.pablolec.play1toolkit.playjobs.service.PlayJobService"/>
        <codeInsight.lineMarkerProvider language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjobs.lineMarker.PlayJobLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjobs.lineMarker.PlayJobInvocationLineMarkerProvider"/>
        <platform.backend.documentation.targetProvider
            implementation="com.github.pablolec.play1toolkit.playjobs.documentation.PlayJobDocumentationTargetProvider"/>
        <completion.contributor language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjobs.completion.PlayJobEveryCompletionContributor"
            order="last"/>
        <localInspection language="JAVA"
            implementationClass="com.github.pablolec.play1toolkit.playjobs.inspection.PlayJobMissingDoJobInspection"
            displayName="Play Job without doJob() method"
            groupName="Play v1 Toolkit"
